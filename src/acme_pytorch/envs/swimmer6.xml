
<mujoco model="n_swimmer">
  <compiler angle="radian"/>
  <default>
    <joint armature="0.1" damping="1.0"/>
    <geom type="capsule" size="0.05 0.1" density="1000"/>
  </default>

  <worldbody>
    <body name="torso" pos="0 0 0">
      <geom size="0.05 0.1"/>
    
        <body name="link0" pos="0.1 0 0">
          <joint name="joint0" type="hinge" axis="0 0 1" range="-100 100"/>
          <geom/>
        
        <body name="link1" pos="0.1 0 0">
          <joint name="joint1" type="hinge" axis="0 0 1" range="-100 100"/>
          <geom/>
        
        <body name="link2" pos="0.1 0 0">
          <joint name="joint2" type="hinge" axis="0 0 1" range="-100 100"/>
          <geom/>
        
        <body name="link3" pos="0.1 0 0">
          <joint name="joint3" type="hinge" axis="0 0 1" range="-100 100"/>
          <geom/>
        
        <body name="link4" pos="0.1 0 0">
          <joint name="joint4" type="hinge" axis="0 0 1" range="-100 100"/>
          <geom/>
        
        <body name="link5" pos="0.1 0 0">
          <joint name="joint5" type="hinge" axis="0 0 1" range="-100 100"/>
          <geom/>
        </body></body></body></body></body></body>
    </body>
  </worldbody>

  <actuator>
    <motor joint="joint0" ctrlrange="-1 1"/>
<motor joint="joint1" ctrlrange="-1 1"/>
<motor joint="joint2" ctrlrange="-1 1"/>
<motor joint="joint3" ctrlrange="-1 1"/>
<motor joint="joint4" ctrlrange="-1 1"/>
<motor joint="joint5" ctrlrange="-1 1"/>
  </actuator>
</mujoco>
